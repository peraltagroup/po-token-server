# PO Token server configuration.
# Copy to `.env` and fill in the values. Every variable is prefixed with PO_.
#
#   cp .env.example .env

# --- Server ---------------------------------------------------------------
PO_HOST=0.0.0.0
PO_PORT=4416
# Public base URL used to build the OAuth redirect URI. This MUST be the URL
# that the IdP (and your browser) can reach, e.g. https://po.example.com or
# http://192.168.1.50:4416.
PO_PUBLIC_URL=http://localhost:4416
PO_DEBUG=false

# --- Security / signing (REQUIRED in production) --------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PO_JWT_SECRET=
PO_JWT_ALGORITHM=HS256
PO_JWT_ISSUER=po-token-server
PO_JWT_AUDIENCE=po-token-clients
PO_ACCESS_TOKEN_TTL=900
PO_REFRESH_TOKEN_TTL=2592000
# Fernet key material for encrypting stored secrets at rest.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PO_SECRET_KEY=

# --- OAuth 2.0 / OIDC client (REQUIRED) -----------------------------------
# Google (default). For another provider, point the discovery URL at its
# /.well-known/openid-configuration and register a matching client.
PO_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
PO_OAUTH_CLIENT_ID=
PO_OAUTH_CLIENT_SECRET=
PO_OAUTH_SCOPES=openid email profile
PO_OAUTH_REDIRECT_PATH=/auth/callback

# --- Storage --------------------------------------------------------------
# Relative paths are resolved against the working directory. In Docker the
# compose file overrides these to absolute /data paths.
PO_DATABASE_URL=sqlite+aiosqlite:///./data/po_token.db
PO_DATA_DIR=./data

# --- PO token generation --------------------------------------------------
PO_CACHE_TTL=21600
PO_PLAYER_CLIENTS=web_music,web,android

# --- Rate limiting --------------------------------------------------------
PO_RATE_LIMIT_AUTH=20
PO_RATE_LIMIT_TOKEN=120
PO_RATE_LIMIT_WINDOW=60

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins, or * for any.
PO_CORS_ORIGINS=*
