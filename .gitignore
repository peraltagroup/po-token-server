# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Local secrets / runtime data — NEVER commit these
.env
# Ignore the runtime SQLite data dir (PO_DATA_DIR defaults to ./data) ...
data/
# ... but force-include the add-on manifest dir which MUST be committed.
!data/
!data/amd64/
!data/amd64/*
*.db
*.db-wal
*.db-shm

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
client_secret_*.json
